all:
  children:
    k3s_cluster:
      children:
        server:
          hosts:
            k3s-server:
              ansible_host: "X.X.X.X"          # IP publique du control-plane
              ansible_user: root
              # ansible_ssh_private_key_file: ~/.ssh/id_ed25519

        agents:
          hosts:
            k3s-agent-1:
              ansible_host: "Y.Y.Y.Y"
              ansible_user: root
            k3s-agent-2:
              ansible_host: "Z.Z.Z.Z"
              ansible_user: root

  vars:
    ansible_python_interpreter: /usr/bin/python3
