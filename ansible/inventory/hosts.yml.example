all:
  children:
    k3s_cluster:
      children:
        server:
          hosts:
            k3s-server:
              ansible_host: "192.168.1.110"     # IP du control-plane
              ansible_user: ubuntu
              # ansible_ssh_private_key_file: ~/.ssh/id_ed25519

        agents:
          hosts:
            k3s-agent-1:
              ansible_host: "192.168.1.111"
              ansible_user: ubuntu
            k3s-agent-2:
              ansible_host: "192.168.1.112"
              ansible_user: ubuntu

  vars:
    ansible_python_interpreter: /usr/bin/python3
    ansible_become: true
